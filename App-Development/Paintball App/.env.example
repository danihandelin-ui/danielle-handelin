VITE_YOUTUBE_API_KEY=

# GEMINI_API_KEY: Required for the backend to call Gemini AI API.
# Keep this secret — it should only be on the backend server, never in the browser.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# VITE_API_URL: Optional. Backend API URL for the frontend to call.
# Defaults to http://localhost:3001 during development.
# Set this when deploying the backend to production.
VITE_API_URL="http://localhost:3001"

# APP_URL: The URL where this applet is hosted (if deploying to cloud).
APP_URL="MY_APP_URL"
